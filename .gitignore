# --- firmwares et images memoire -------------------------------------------
*.bin
*.dfu
*.elf
*.hex
!firmware/core/bundled/internal.bin
!firmware/core/bundled/external.bin
firmware/core/build/
firmwares/
epsilon-officiel/

# --- etat local de la calculatrice emulee ----------------------------------
#  Le dossier rom\ est un espace de travail, pas du code. Les scripts qui s'y
#  trouvent viennent des exemples livres avec la calculatrice : eux non plus
#  n'ont pas a etre redistribues.
rom/sram.bin
rom/.storage.bin
rom/.storage.json
rom/load.resc
rom/scripts/
rom/.scripts-precedents/
rom/sauvegardes/
rom/.scripts-*/
rom/.sessions/
rom/.session.lock
rom/.firmware-pending/
rom/*.tmp

# --- artefacts de compilation ----------------------------------------------
app/bin/
app/obj/
tests/bin/
tests/obj/
EmuWorks.exe
NumWorks.exe

# --- traces, captures, sorties de debogage ---------------------------------
*.raw
/*.png
trace*.txt
out.txt
lancement.txt
emb*.txt
*.log
*.erreur.txt

# Original EmuWorks Code images and independent user scripts
!firmware/code/bundled/internal.bin
!firmware/code/bundled/external.bin
rom/code-scripts/

# Local release archives and build output
releases/

# Local application preferences and independent script rollback data
/settings.json
rom/.code-scripts-*/
