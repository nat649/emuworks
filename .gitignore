# --- firmwares et images memoire -------------------------------------------
*.bin
*.dfu
*.elf
*.hex
firmwares/
epsilon-officiel/

# --- etat local de la calculatrice emulee ----------------------------------
#  Le dossier rom\ est un espace de travail, pas du code. Les scripts qui s'y
#  trouvent viennent des exemples livres avec la calculatrice : eux non plus
#  n'ont pas a etre redistribues.
rom/sram.bin
rom/.storage.bin
rom/.storage.json
rom/load.resc
rom/scripts/
rom/.scripts-precedents/

# --- artefacts de compilation ----------------------------------------------
app/bin/
app/obj/
EmuWorks.exe
NumWorks.exe

# --- traces, captures, sorties de debogage ---------------------------------
*.raw
/*.png
trace*.txt
out.txt
lancement.txt
emb*.txt
*.log
*.erreur.txt
